{
  "name": "tanstack-dashboard",
  "private": true,
  "version": "1.14.2",
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:node": "tsc --project tsconfig.node.json --noEmit",
    "typecheck:all": "bun run typecheck && bun run typecheck:node",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "check": "oxlint --fix && oxfmt",
    "check:ci": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "dev": "concurrently \"bun run client\" \"bun run server\"",
    "client": "bun --bun vite",
    "server": "cd ./backend && bun run dev",
    "server:test": "cd ./backend && bun run dev:test",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "knip:deps": "knip --dependencies",
    "knip:client": "knip --workspace . --dependencies",
    "knip:fix": "knip --fix --fix-type dependencies",
    "test:e2e": "bun --env-file=.env playwright test",
    "test:e2e:ui": "bun --env-file=.env playwright test --ui",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@hookform/resolvers": "^5.4.0",
    "@lingui/core": "^5.9.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "^1.170.11",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.14",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-de": "^4.1.1",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "dayjs": "^1.11.21",
    "i18n-iso-countries": "^7.14.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.564.0",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.2.3",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.77.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/macro": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@lingui/vite-plugin": "^5.9.5",
    "@playwright/test": "^1.60.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.7",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
