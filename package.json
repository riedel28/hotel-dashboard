{
  "name": "tanstack-dashboard",
  "private": true,
  "version": "1.14.0",
  "type": "module",
  "scripts": {
    "build": "bun run type-check && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "type-check": "tsc --project tsconfig.json --noEmit",
    "type-check:node": "tsc --project tsconfig.node.json --noEmit",
    "type-check:all": "bun run type-check && bun run type-check:node",
    "lint": "biome lint --write",
    "lint:ci": "biome lint .",
    "check": "biome check --write",
    "check:ci": "biome check",
    "format": "biome format --write",
    "dev": "concurrently \"bun run client\" \"bun run server\"",
    "client": "bun --bun vite",
    "server": "cd ./backend && bun run dev",
    "server:test": "cd ./backend && bun run dev:test",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "knip:deps": "knip --dependencies",
    "knip:client": "knip --workspace . --dependencies",
    "knip:fix": "knip --fix --fix-type dependencies",
    "test:e2e": "bun --env-file=.env playwright test",
    "test:e2e:ui": "bun --env-file=.env playwright test --ui",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@headless-tree/core": "^1.6.3",
    "@headless-tree/react": "^1.6.3",
    "@hookform/resolvers": "^5.2.2",
    "@lingui/core": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.160.0",
    "@tanstack/react-router-devtools": "^1.160.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.160.0",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.13",
    "dayjs": "^1.11.19",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@lingui/babel-plugin-lingui-macro": "^5.9.1",
    "@lingui/cli": "^5.9.1",
    "@lingui/macro": "^5.9.1",
    "@lingui/react": "^5.9.1",
    "@lingui/vite-plugin": "^5.9.1",
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "1.3.9",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.0.18",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.6.1",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
