{
  "name": "tanstack-dashboard",
  "private": true,
  "version": "1.41.0",
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:node": "tsc --project tsconfig.node.json --noEmit",
    "typecheck:all": "bun run typecheck && bun run typecheck:node",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "check": "oxlint --fix && oxfmt",
    "check:ci": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "dev": "concurrently \"bun run client\" \"bun run server\"",
    "client": "bun --bun vite",
    "server": "cd ./backend && bun run dev",
    "server:test": "cd ./backend && bun run dev:test",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "knip:deps": "knip --dependencies",
    "knip:client": "knip --workspace . --dependencies",
    "knip:fix": "knip --fix --fix-type dependencies",
    "test:e2e": "bun --env-file=.env playwright test",
    "test:e2e:ui": "bun --env-file=.env playwright test --ui",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "intent": {
    "skills": [
      "@tanstack/react-table",
      "@tanstack/table-core"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.2",
    "@lingui/core": "^6.11.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.48",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-de": "^4.1.1",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dayjs": "^1.11.23",
    "i18n-iso-countries": "^7.14.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "sanitize-html": "^2.18.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.11.0",
    "@lingui/cli": "^6.11.0",
    "@lingui/macro": "^5.9.5",
    "@lingui/react": "^6.11.0",
    "@lingui/vite-plugin": "^6.11.0",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tanstack/intent": "^0.5.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "^10.0.6",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
